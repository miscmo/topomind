# Go server env for the pure Web + Go backend migration.
APP_ENV=development
HTTP_ADDR=:3000
DATABASE_URL=postgres://topomind:topomind@127.0.0.1:5432/topomind_dev?sslmode=disable
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ATTACHMENT_TICKET_SECRET=change-me-attachment-ticket
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.local/storage
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:*,http://127.0.0.1:*
