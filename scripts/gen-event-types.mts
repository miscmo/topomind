/**
 * 事件目录生成器（v3 P1.2）。
 *
 * 单一真源是 src/shared/observability/eventCatalog.ts；本脚本只做「派生」：
 *   1) src/shared/observability/eventTypes.generated.ts —— TS 联合类型与标签表
 *   2) electron/log-categories.generated.js —— 主进程 JS 边界可用的分类数据
 *
 * 主进程无法 import TS，且 v3 明确禁止手写副本（v2 的教训：字符串存在性
 * 门禁全绿却口径漂移）。verify-logging.mts 的 C9 会 import 本模块的
 * buildGenerated*() 与磁盘产物逐字比对，产物过期即失败。
 *
 * 用法：npm run gen:events
 */
import { writeFile } from 'node:fs/promises'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import {
  EVENT_CATALOG,
  CATEGORY_BY_ACTION,
  ACTION_LABELS,
  validateEventCatalog,
} from '../src/shared/observability/eventCatalog.ts'
import {
  LOG_SCHEMA_VERSION,
  LOG_CATEGORY_IDS,
  LOG_CATEGORIES,
  CATEGORY_RETENTION_DAYS,
  CATEGORY_RULES,
} from '../src/shared/observability/logContract.ts'
import { PERFORMANCE_ACTION } from '../src/shared/observability/performanceContract.ts'

const here = path.dirname(fileURLToPath(import.meta.url))
export const GENERATED_PATHS = {
  ts: path.resolve(here, '../src/shared/observability/eventTypes.generated.ts'),
  js: path.resolve(here, '../electron/log-categories.generated.js'),
} as const

const HEADER = '// AUTO-GENERATED by scripts/gen-event-types.mts — DO NOT EDIT.\n// 单一真源：src/shared/observability/eventCatalog.ts\n'

function json(value: unknown): string {
  return JSON.stringify(value, null, 2)
}

/** 按 EventId 顺序生成稳定的联合类型与三张查找表。 */
export function buildGeneratedTs(): string {
  const ids = EVENT_CATALOG.map((spec) => spec.id)
  const union = ids.map((id) => `  | ${JSON.stringify(id)}`).join('\n')
  const labels = Object.fromEntries(EVENT_CATALOG.map((s) => [s.id, s.label]))
  const categories = Object.fromEntries(EVENT_CATALOG.map((s) => [s.id, s.category]))
  const retention = Object.fromEntries(EVENT_CATALOG.map((s) => [s.id, s.retentionDays]))
  return `${HEADER}
/** 事件目录里的全部事件 id；新增 action / 指标后运行 npm run gen:events 更新。 */
export type EventId =
${union}

export const EVENT_IDS: readonly EventId[] = ${json(ids)}

/** 人读中文标签（UI 筛选器、详情面板共用，禁止在组件里手写）。 */
export const EVENT_LABELS: Record<EventId, string> = ${json(labels)}

export const EVENT_CATEGORY_BY_ID: Record<EventId, string> = ${json(categories)}

/** 分级保留期，与 ELECTRON 侧 electron/log-categories.generated.js 同源。 */
export const EVENT_RETENTION_DAYS_BY_ID: Record<EventId, number> = ${json(retention)}
`
}

/** 纯数据，不含逻辑：主进程用它做分类兜底、保留期清理与老日志 label 补齐。 */
export function buildGeneratedJs(): string {
  const categoryLabels = Object.fromEntries(
    LOG_CATEGORY_IDS.map((id) => [id, LOG_CATEGORIES[id].label]),
  )
  return `${HEADER}
export const LOG_SCHEMA_VERSION = ${LOG_SCHEMA_VERSION};
export const LOG_CATEGORY_IDS = ${json(LOG_CATEGORY_IDS)};
export const CATEGORY_LABELS = ${json(categoryLabels)};
export const CATEGORY_RETENTION_DAYS = ${json(CATEGORY_RETENTION_DAYS)};
export const CATEGORY_BY_ACTION = ${json(CATEGORY_BY_ACTION)};
export const ACTION_LABELS = ${json(ACTION_LABELS)};
export const PERFORMANCE_ACTION_ID = ${JSON.stringify(PERFORMANCE_ACTION)};
export const DEFAULT_CATEGORY = ${JSON.stringify(CATEGORY_RULES.defaultCategory)};
export const CATEGORY_RULES = ${json(CATEGORY_RULES)};
`
}

const isMain = (() => {
  const entry = process.argv[1]
  if (!entry) return false
  try { return path.resolve(entry) === fileURLToPath(import.meta.url) } catch { return false }
})()

if (isMain) {
  const problems = validateEventCatalog()
  if (problems.length > 0) {
    console.error(`EVENT_CATALOG_INVALID: ${problems.length} problems`)
    for (const problem of problems) console.error(`- ${problem}`)
    process.exit(1)
  }
  await writeFile(GENERATED_PATHS.ts, buildGeneratedTs(), 'utf8')
  await writeFile(GENERATED_PATHS.js, buildGeneratedJs(), 'utf8')
  console.log(`EVENT_TYPES_GENERATED: ${EVENT_CATALOG.length} events -> 2 files`)
}
