{
  "name": "topomind",
  "version": "5.2.1",
  "description": "TopoMind — 可漫游拓扑知识大脑",
  "author": {
    "name": "TopoMind",
    "email": "support@topomind.app"
  },
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit --pretty false",
    "clean": "node -e \"const fs=require('fs');['dist','dist-electron'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build": "npm run clean && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.topomind.app",
    "productName": "TopoMind",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.svg",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "TopoMind <support@topomind.app>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@antv/x6": "^2.19.2",
    "@antv/x6-plugin-clipboard": "^2.1.6",
    "@antv/x6-plugin-history": "^2.2.4",
    "@antv/x6-plugin-keyboard": "^2.2.3",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@antv/x6-plugin-snapline": "^2.1.7",
    "@antv/x6-plugin-stencil": "^2.1.5",
    "@antv/x6-plugin-transform": "^2.1.8",
    "@blocknote/code-block": "^0.51.2",
    "@blocknote/core": "^0.51.2",
    "@blocknote/mantine": "^0.51.2",
    "@blocknote/react": "^0.51.2",
    "@fontsource/inter": "^5.2.8",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/katex": "^0.16.8",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.10.2",
    "blocknote-mermaid": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "katex": "^0.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-mind-map": "^0.14.0-fix.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "puppeteer": "^24.43.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
