{
  "name": "topomind",
  "version": "5.2.1",
  "description": "TopoMind — 可漫游拓扑知识大脑",
  "private": true,
  "author": {
    "name": "TopoMind",
    "email": "support@topomind.app"
  },
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @topomind/web",
    "dev:web": "npm run dev --workspace @topomind/web",
    "dev:desktop": "npm run dev --workspace @topomind/desktop",
    "typecheck": "npm run typecheck --workspace @topomind/web",
    "typecheck:web": "npm run typecheck --workspace @topomind/web",
    "typecheck:desktop": "npm run typecheck --workspace @topomind/desktop",
    "build": "npm run build --workspace @topomind/web",
    "build:web": "npm run build --workspace @topomind/web",
    "build:desktop": "npm run build --workspace @topomind/web && npm run start --workspace @topomind/desktop",
    "preview": "npm run preview --workspace @topomind/web",
    "preview:web": "npm run preview --workspace @topomind/web",
    "start:desktop": "npm run start --workspace @topomind/desktop"
  }
}
