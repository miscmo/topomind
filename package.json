{
  "name": "topomind",
  "version": "5.2.1",
  "description": "TopoMind — 可漫游拓扑知识大脑",
  "author": {
    "name": "TopoMind",
    "email": "support@topomind.app"
  },
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node ./scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "verify:lint:baseline": "node scripts/verify-lint-baseline.mjs",
    "lint:baseline:update": "node scripts/verify-lint-baseline.mjs --update",
    "verify:plugins:static": "node --experimental-strip-types --experimental-specifier-resolution=node ./scripts/verify-plugin-static-discovery.mts",
    "verify:plugins:boundaries": "node --experimental-strip-types --experimental-specifier-resolution=node ./scripts/verify-plugin-boundaries.mts",
    "verify:plugins:runtime": "node --experimental-strip-types --experimental-specifier-resolution=node ./scripts/verify-plugin-runtime-guards.mts",
    "verify:plugins": "node ./scripts/verify-plugins.mjs",
    "verify:critical": "node --experimental-strip-types --experimental-specifier-resolution=node ./scripts/verify-critical-regressions.mts",
    "verify:design": "node scripts/verify-design-system.mjs",
    "emoji:build": "node scripts/build-emoji-assets.mjs",
    "verify": "node scripts/verify-all.mjs",
    "prebuild": "node ./scripts/prepare-assets.mjs --design",
    "verify:graph-store": "node --experimental-strip-types --experimental-specifier-resolution=node ./scripts/verify-graph-store.mts",
    "perf:calibrate": "node --experimental-strip-types scripts/analyze-performance-scale.mts",
    "verify:linked:gui": "node scripts/verify-linked-documents-gui.mjs",
    "verify:container:gui": "node scripts/verify-container-gui.mjs",
    "clean": "node -e \"const fs=require('fs');['dist','dist-electron'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build": "node ./scripts/build.mjs",
    "prebuild:mac": "npm run build",
    "build:mac": "electron-builder --mac",
    "prebuild:win": "npm run build",
    "build:win": "node ./scripts/build-win.mjs",
    "prebuild:linux": "npm run build",
    "build:linux": "electron-builder --linux",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.topomind.app",
    "productName": "TopoMind",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "TopoMind <support@topomind.app>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@blocknote/xl-multi-column": "^0.51.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "@floating-ui/react": "^0.27.19",
    "@fontsource/inter": "^5.2.8",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@radix-ui/react-slot": "^1.2.5",
    "@tiptap/core": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.11.0",
    "blocknote-mermaid": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.4.9",
    "emoji-picker-react": "5.1.4",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.2.0",
    "simple-mind-map": "^0.14.0-fix.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lobehub/fluent-emoji-flat": "1.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.2",
    "emojibase-data": "18.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "pinyin-pro": "3.29.5",
    "postcss": "^8.5.15",
    "puppeteer": "^24.43.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "overrides": {
    "blocknote-mermaid": {
      "@blocknote/core": "$@blocknote/core",
      "@blocknote/react": "$@blocknote/react",
      "@blocknote/mantine": "$@blocknote/mantine"
    }
  }
}
