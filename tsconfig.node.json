  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "outDir": "./node_modules/.cache/tsconfig.node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.js", "electron/**/*.js"]
}
